/* M1 슬롯 — SRD = 0 (매 tSSP).
 * ★ enable/disable 로 게이팅하므로 SRD 는 반드시 0 이어야 한다.
 *   SRD 를 29 로 두면 M1 을 켠 뒤 최대 30 tSSP 를 더 기다린다. */
#define CA_M1_CFG_ON            ((uint8_t)(MN_MODE_CHRONO_A << MN_MODE_SHIFT))  /* 0x40 */
#define CA_M1_CFG_OFF           0x00u

#define CA_POLL_SEC              2u     /* FIFO 확인 주기 [s] — 1회 약 2ms */
#define CA_WAIT_MARGIN_SEC       5u
#define CA_RELAX_SEC            15u     /* 재측정 전 전극 이완 (≥5τ) */
#define CA_RETRY_MAX             2u     /* 프로브 → 정식 행, 1회면 충분 */
#define CA_DC_DISCARD_N          5u     /* chrono 후 버릴 PSTAT 샘플 수 */


/* ==========================================================================
 * SPS 테이블
 *   전 행 STEP 100 샘플. ISP 를 2배씩 올려 τ 를 2배씩 커버.
 *   div 가 전부 2의 거듭제곱이라 isp_sec 이 float 에서 정확히 표현된다.
 *   duration_ms = (PRE 4 + STEP 100 + BLANK 1) × ISP = 105 × ISP
 *   CONV_TIME 은 각 ISP 미만에서 최대값 — 노이즈 ∝ 1/√(적분시간)
 * ========================================================================== */
const chrono_A_cfg_t chrono_A_cfg[CHRONO_SPS_COUNT] = {
/*     div      isp_sec       m1_conv                            conv_sec  dur_ms */
    { 0x0080u, 0.00390625f, MN_CONV_SIGNED(CONV_TIME_2_76MS), 0.00276f,   411u },
    { 0x0100u, 0.00781250f, MN_CONV_SIGNED(CONV_TIME_2_76MS), 0.00276f,   821u },
    { 0x0200u, 0.01562500f, MN_CONV_SIGNED(CONV_TIME_2_76MS), 0.00276f,  1641u },
    { 0x0400u, 0.03125000f, MN_CONV_SIGNED(CONV_TIME_20MS),   0.020f,    3282u },
    { 0x0800u, 0.06250000f, MN_CONV_SIGNED(CONV_TIME_40MS),   0.040f,    6563u },
    { 0x1000u, 0.12500000f, MN_CONV_SIGNED(CONV_TIME_100MS),  0.100f,   13125u },
    { 0x2000u, 0.25000000f, MN_CONV_SIGNED(CONV_TIME_200MS),  0.200f,   26250u }
};

