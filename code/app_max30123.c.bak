static uint16_t ca_deadline_s  = 0u;
static uint8_t  ca_retry       = 0u;


/************************************************************************************************************************
 *   SPI CONTROL
 ************************************************************************************************************************/
int spidrv_write_max30123_reg_action(const  uint8_t reg,  const uint8_t  val)
{
    int result;
    uint8_t buffer[4];

    buffer[0] = val;
    result=cem102->max30123_write_reg_action(cem102_dut,   reg, buffer, 1);

    return result;
}

/******************************************************************************************
 *	reg 값을 1개씩 읽어 온다
 ******************************************************************************************/
uint8_t spidrv_read_max30123_reg_action(const  uint8_t reg)
{
    int result;
    uint8_t buffer[4];

    result=cem102->max30123_read_reg_action(cem102_dut,  reg, buffer, 1);

    if (result == ERRNO_NO_ERROR) {
        return buffer[0];
    }

    return 0;
}

/******************************************************************************************
 *	DATA BUFFER 만큼 wlen만큼 전송 한다
 ******************************************************************************************/
int spidrv_write_max30123_reg_buffer(const  uint8_t reg, uint8_t *wbuffer, uint16_t wlen)
{
    int result;

    result=cem102->max30123_write_reg_action(cem102_dut, reg, wbuffer, wlen);
    return result;
}

/******************************************************************************************
 *	DATA BUFFER 만큼 rlen만큼 읽어 온다.
 ******************************************************************************************/
int spidrv_read_max30123_reg_buffer(const  uint8_t reg, uint8_t *rbuffer, uint16_t rlen)
{
    int result;

    result = cem102->max30123_read_reg_action(cem102_dut,  reg, rbuffer, rlen);

    return result;
}


void max30123_delay_ms(int i)
{
	do {
		Sys_Delay(SystemCoreClock / 1000);	// 1ms wait
	} while(i-->0);
}

/************************************************************************************************************************
 *   mac30123 value memory attach
 ************************************************************************************************************************/
void max30123_malloc_attach(void)
{
	memset(&impedance_result, 0, sizeof(impedance_result_t));
	memset(&impedance_calendar, 0, sizeof(impedance_calendar_t));

}

/*************************************************************************************************************************
 * 	MAX30132 REGISTER INITIAL
 *************************************************************************************************************************/
void max30123_reg_initial(void)
{
	uint8_t i;
	uint8_t  result;

	max30123_malloc_attach();

	swmLogInfo("\r\nSERIAL ID : ");
	for(i=0;i<5;i++) {
		result = spidrv_read_max30123_reg_action(0xAA+i);
		swmLogInfo("[0x%02X] ", result);
	}
	swmLogInfo("\r\n");

	result = spidrv_read_max30123_reg_action(0xFE);
#ifdef _MAX30123_INFO_DEBUG_
	swmLogInfo(" FE : [0x%02X]\r\n", result);
#endif

	result = spidrv_read_max30123_reg_action(PART_IDENTIFIER);
#ifdef _MAX30123_INFO_DEBUG_
	swmLogInfo(" FF : [0x%02X]\r\n", result);
#endif

	if(result == MAX30123_PART_ID) {
		for(i=0;i<MAX30123_TBL_SIZE;i++) {
			spidrv_write_max30123_reg_action(max30123_reg_tbl[i].reg, max30123_reg_tbl[i].val);
		}
	}
}


/***********************************************************************************************************************
 *		MAX30132  INITIAL & POWER ON STATUS WAIT...1초 동안 기다린다...
 *		POWER ON 이 된 뒤 전원 안정화를 위해 2초 뒤 주파수 초기화를 한다...
 ***********************************************************************************************************************/
void max30123_power_on_ready(void)
{
	uint8_t tmout;
	uint8_t status;

	tmout = 200;

#ifdef _MAX30123_INFO_DEBUG_
		swmLogInfo("Software Reset\r\n");
#endif

	spidrv_write_max30123_reg_action(MAX30123_REG_SYSCTRL1, SYSCTRL1_RESET);

	do {
		status = spidrv_read_max30123_reg_action(MAX30123_REG_STATUS1);

#ifdef _MAX30123_INFO_DEBUG_
		swmLogInfo("STATUS_1 : %02X\r\n", status);
#endif

		if((status&STATUS1_PWR_RDY)==STATUS1_PWR_RDY_OK) {
			break;
		}

		Sys_Delay(SystemCoreClock / 100);				// 10ms wait
	} while(tmout-->0);
}

/********************************************************************************
 *	600mV, 600mV --> 800mV, 600mV ==> 200mV
 ********************************************************************************/
void max30123_DAC_power_on(void)
{
	spidrv_write_max30123_reg_action(MAX30123_REG_DACA_MSB, 0xC8);
	spidrv_write_max30123_reg_action(MAX30123_REG_DACB_MSB, 0x96);
}

/********************************************************************************
 *
 ********************************************************************************/
void max30123_PSTAT_config_Idle_mod(const uint8_t idle_mode)
{
	uint8_t reg_val = 0;

	reg_val = spidrv_read_max30123_reg_action(MAX30123_REG_WE1_CFG1);

	if(idle_mode==ENABLE) {
		spidrv_write_max30123_reg_action(MAX30123_REG_PSTAT_CFG, 0x0F);		// POR_DUTY(1) | HALF_CP_CLK(1) | AFE_CHOP_EN(1) | HALF_IB(1)

		reg_val|=WE1_CFG1_CHOP_EN;
		spidrv_write_max30123_reg_action(MAX30123_REG_WE1_CFG1, reg_val);
	}
	else {
		spidrv_write_max30123_reg_action(MAX30123_REG_PSTAT_CFG, 0x0A);		// POR_DUTY(1) | HALF_CP_CLK(0) | AFE_CHOP_EN(1) | HALF_IB(0)

		reg_val&=~WE1_CFG1_CHOP_EN;
		spidrv_write_max30123_reg_action(MAX30123_REG_WE1_CFG1, reg_val);
	}
}

/********************************************************************************
 *	CONVERTER MODE : AUTO MODE & MANUAL MODE
 ********************************************************************************/
void max30123_reg_convert_mode(uint8_t mode, uint8_t converter)
{
	uint8_t reg_val = 0;

	reg_val = spidrv_read_max30123_reg_action(MAX30123_REG_CONVERT_MODE);
	reg_val&= 0xFC;
	reg_val = (reg_val | mode | converter);

	spidrv_write_max30123_reg_action(MAX30123_REG_CONVERT_MODE, reg_val);
}



/********************************************************************************
 * CONVERT MODE START
 * STATUS 1 상태 확인
 ********************************************************************************/
uint8_t max30123_reg_convert_and_status(void)
{
	uint8_t results = 0;
	uint8_t status = 0;
	int loop = 300;

	spidrv_write_max30123_reg_action(MAX30123_REG_CONVERT_MODE, CONVERT_MODE_CONVERT);

	do {
		status = spidrv_read_max30123_reg_action(MAX30123_REG_STATUS1);
		if (status & STATUS1_ADC_DATA_RDY) {
			results = 1;
			break;
		} else {
			max30123_delay_ms(10);
		}
	} while (loop--> 0);

	return results;
}

/* ==========================================================================
 * 코드 → 전류 변환
 *   AUTO_SUBTRACT=1, I_CONV_TYPE=signed → 16bit 2's complement
 *   I[nA] = FS × (int16)raw / 32768
 * ========================================================================== */
static inline float ca_code_to_nA(uint16_t raw)
{
    return CA_FS_NA * ((float)(int16_t)raw / 32768.0f);
}

static inline float dc_code_to_nA(uint16_t raw)
{
    return MAX30123_DC_FS_NA * ((float)(int16_t)raw / 32768.0f);
}


/********************************************************************************
 * @brief 현재 FIFO에 저장된 유효 샘플 수를 확인합니다.
 * @return 읽기 가능한 샘플 수 (0~256)
 ********************************************************************************/
uint16_t max30123_get_fifo_count(void)
{
	uint8_t buf[2];
	spidrv_read_max30123_reg_buffer(MAX30123_REG_FIFO_COUNTER1, buf, 2);
	return  (uint16_t)(((buf[0] & 0x80) << 1) | buf[1]);
}

uint8_t max30123_get_fifo_ovf(void)
{
    uint8_t buf[2];
    spidrv_read_max30123_reg_buffer(MAX30123_REG_FIFO_COUNTER1, buf, 2);
    return (uint8_t)(buf[0] & 0x7Fu);           /* OVF_COUNTER[6:0] */
}
/********************************************************************************
 * @brief FIFO에서 샘플 1개를 읽어옵니다.
 * @param sample 읽어온 데이터를 저장할 구조체 포인터
 * @return 성공 시 true, FIFO가 비어있으면 false
 ********************************************************************************/
int8_t max30123_read_fifo_data(max30123_fifo_t *p)
{
	uint8_t buf[3];

    cem102->max30123_read_reg_action(cem102_dut, MAX30123_REG_FIFO_DATA, buf, 3);

    if (buf[0] == 0xFF && buf[1] == 0xFF && buf[2] == 0xFF) {
        return 0;
    }

    p->meas_id   = (buf[0] >> 5) & 0x07;
    p->data_type = buf[0] & 0x1F;
    p->adc_val   = (uint16_t)((buf[1] << 8) | buf[2]);

#if _MAX30123_INFO_DEBUG_
	swmLogInfo("fifo_data : [%02x][%02x][%02x] \r\n", p->meas_id, p->data_type, p->adc_val);
    max30123_delay_ms(1u);
#endif

    return 1;
}

void max30123_fifo_flush(void)
{
    /* FIFO_RO 는 넣지 않는다 — 켜지면 오버플로 시 오래된 데이터를 덮어써서
     * 버스트 앞부분이 조용히 사라진다. OFF 면 뒤가 잘리고 OVF 로 검출된다. */
    spidrv_write_max30123_reg_action(MAX30123_REG_FIFO_CONFIG2,
                                     FIFO_CFG2_FLUSH_FIFO
                                   | FIFO_CFG2_FIFO_STAT_CLR
                                   | FIFO_CFG2_A_FULL_TYPE);
}




/***********************************************************************************************************************
 *	#1. MAX30123 measure calibration
 ***********************************************************************************************************************/
#define CAL_OFFSET_EXPECT   32768u    /* OFFSET_SEL = 50% FS 기대 카운트 */
#define CAL_OFFSET_TOL       6554u    /* ±20% — 실측 산포로 조일 것   */
uint8_t max30123_measure_calibration(uint16_t *offset_out)
{
    uint8_t m0_cfg;
    uint8_t saved_conv, saved_avg, saved_cfg2;
    uint8_t off_buf[2];
    uint16_t stored;
	uint16_t fifo_count;

    if (offset_out == NULL) { return 0u; }
    *offset_out = 0u;

	spidrv_write_max30123_reg_action(MAX30123_REG_PSTAT_CFG, 0x0F);		// POR_DUTY(1) | HALF_CP_CLK(1) | AFE_CHOP_EN(1) | HALF_IB(1)
/*************************************************************************************
 *	STEP 0 : M0 가 PSTAT(Amperometric) 인지 확인.
 *	 		아니면 offset-only 측정 자체가 일어나지 않는다.
 *************************************************************************************/
    m0_cfg = spidrv_read_max30123_reg_action(MAX30123_REG_M0_CFG);
    if (((m0_cfg >> 5) & 0x07u) != MN_MODE_PSTAT) {
        return 0u;
    }

#if _EIS_FIFO_INFO_DEBUG_
	swmLogInfo("[CAL] M0_MODE PSTAT : 0x%02X, 0x%02X\r\n", m0_cfg, ((m0_cfg >> 5) & 0x07u));
#endif

// STEP 1 : STORE_OFFSET = 1
    saved_cfg2 = spidrv_read_max30123_reg_action(MAX30123_REG_WE1_CFG2);
    spidrv_write_max30123_reg_action(MAX30123_REG_WE1_CFG2,
                                     saved_cfg2 | WE1_CFG2_STORE_OFFSET);
#if _EIS_FIFO_INFO_DEBUG_
	swmLogInfo("MAX30123_REG_WE1_CFG2 : [0x%02X] \r\n", saved_cfg2);
#endif

// STEP 2 : M0 I_CONV_TYPE → 01 (Offset only)
	saved_conv = spidrv_read_max30123_reg_action(MAX30123_REG_M0_CONV);
	spidrv_write_max30123_reg_action(MAX30123_REG_M0_CONV,
								 (saved_conv & 0x3Fu)
							   | (I_CONV_OFFSET_ONLY << MN_I_CONV_TYPE_SHIFT));

#if _EIS_FIFO_INFO_DEBUG_
	swmLogInfo("MAX30123_REG_M0_CONV : [0x%02X] \r\n", saved_conv);
#endif

//	STEP 3 : 1회 보정이므로 MEAS_AVE로 충분히 평균. SMP_AVE는 AUTO=1 전용이라 Manual 단발에서는 반드시 0.
	saved_avg = spidrv_read_max30123_reg_action(MAX30123_REG_M0_AVG);
	spidrv_write_max30123_reg_action(MAX30123_REG_M0_AVG, MEAS_AVE_8);

//	STEP 4 : AFE 정착 대기 (초퍼 + 오프셋 전류. 실측으로 조정)
    max30123_delay_ms(50u);

//----------------------------------------------------------------------------------------------------------------------------------------
// STEP 5 : FIFO flush
	spidrv_write_max30123_reg_action(MAX30123_REG_FIFO_CONFIG2,
										FIFO_CFG2_FLUSH_FIFO |
										FIFO_CFG2_FIFO_STAT_CLR |
										FIFO_CFG2_A_FULL_TYPE);

	if(max30123_reg_convert_and_status() == 0)
		goto cleanup;								// 복원 후 나와야 한다..

// STEP 6 : FIFO에서 캘리브레이션 데이터 읽기 (버려도 됨)
	fifo_count = max30123_get_fifo_count();
	while (fifo_count > 0u) {
	    max30123_read_fifo_data(&max30123_fifo);
	    fifo_count--;
	}


// STEP 5 : WE1_I_OFFSET 검증
	spidrv_read_max30123_reg_buffer(MAX30123_REG_WE1_I_OFFSET_MSB, off_buf, 2);

    stored = ((uint16_t)off_buf[0] << 8) | off_buf[1];
	*offset_out = stored;

    if ((stored > (CAL_OFFSET_EXPECT + CAL_OFFSET_TOL)) ||
        (stored < (CAL_OFFSET_EXPECT - CAL_OFFSET_TOL))) {
#if _EIS_FIFO_INFO_DEBUG_
        swmLogInfo("[CAL] offset out of range : %u (expect ~%u)\r\n",
                   stored, CAL_OFFSET_EXPECT);
#endif
        goto cleanup;
    }

#if _EIS_FIFO_INFO_DEBUG_
	swmLogInfo("WE1_I_OFFSET : 0x%02X 0x%02X [%d] \r\n", off_buf[0], off_buf[1], stored);
#endif

cleanup:
    spidrv_write_max30123_reg_action(MAX30123_REG_WE1_CFG2,
    								saved_cfg2  & ~WE1_CFG2_STORE_OFFSET);
    spidrv_write_max30123_reg_action(MAX30123_REG_M0_AVG, saved_avg);
    spidrv_write_max30123_reg_action(MAX30123_REG_M0_CONV,
                                     (saved_conv & 0x3Fu)
                                   | (I_CONV_SIG_SIGNED << MN_I_CONV_TYPE_SHIFT));

    return 1;
}

/***********************************************************************************************************************
 *	#2-1. MAX30123 measure DC current... 수동 모두
 ***********************************************************************************************************************/
uint8_t max30123_measure_DC_manual_mode(float *we_current)
{
    int16_t signed_raw;
    uint16_t fifo_count;
    float nA;

    /* FIFO flush */
    spidrv_write_max30123_reg_action(MAX30123_REG_FIFO_CONFIG2,
                                     FIFO_CFG2_FLUSH_FIFO |
                                     FIFO_CFG2_FIFO_STAT_CLR);

	if(max30123_reg_convert_and_status() == 0)
		return 0;

	fifo_count = max30123_get_fifo_count();
	while (fifo_count > 0u) {
		max30123_read_fifo_data(&max30123_fifo);
		if(max30123_fifo.data_type == FIFO_TYPE_WE1_PSTAT_CURR) {
			signed_raw = (int16_t)max30123_fifo.adc_val;
			nA = ((float)signed_raw / 128.0f);
			*we_current = nA;

#if _EIS_FIFO_INFO_DEBUG_
	swmLogInfo("WE1 : %d, "LOG_FLOAT_MARKER" nA  \r\n ", signed_raw, LOG_FLOAT(nA));
	max30123_delay_ms(1);
#endif
    	}

    	fifo_count--;
	}

    return 1;
}



/***********************************************************************************************************************
 *	#2-2. MAX30123 measure DC current... 수동 모두
 ***********************************************************************************************************************/
uint8_t max30123_measure_DC_auto_mode(float *we_current)
{
	uint8_t status = 0;
    int16_t signed_raw;
    uint16_t fifo_count;
    float nA;


	status = spidrv_read_max30123_reg_action(MAX30123_REG_STATUS1);
#if _EIS_FIFO_INFO_DEBUG_
	swmLogInfo("MAX30123_REG_STATUS1 : %02x \r\n ", status);
#endif

	if (status & STATUS1_ADC_DATA_RDY) {
		fifo_count = max30123_get_fifo_count();
#if _EIS_FIFO_INFO_DEBUG_
		swmLogInfo("fifo_count : %d\r\n ", fifo_count);
		max30123_delay_ms(1);
#endif

		while (fifo_count > 0u) {
			max30123_read_fifo_data(&max30123_fifo);

			if(max30123_fifo.data_type == FIFO_TYPE_WE1_PSTAT_CURR) {
				signed_raw = (int16_t)max30123_fifo.adc_val;
				nA = ((float)signed_raw / 128.0f);
				*we_current = nA;

#if _EIS_FIFO_INFO_DEBUG_
				swmLogInfo("WE1 : %d, "LOG_FLOAT_MARKER" nA  \r\n ", signed_raw, LOG_FLOAT(nA));
				max30123_delay_ms(1);
#endif
	    	}

	    	fifo_count--;
		}

		return 1;
	}

	return 0;
}


/************************************************************************************
 *	#3-1. max30123 chronoamperometry measurement...auto mode
 ************************************************************************************/
uint8_t max30123_chrono_A_measurement_auto_mode(chrono_a_raw_t *out)
{
	uint8_t status = 0;
	uint16_t fifo_count;
	float	nA;

#if _EIS_FIFO_INFO_DEBUG_
    swmLogInfo("max30123_chrono_A_measurement\r\n");
#endif

	status = spidrv_read_max30123_reg_action(MAX30123_REG_STATUS1);
    swmLogInfo("chrono_A : %02x\r\n", status);

	if (status & STATUS1_ADC_DATA_RDY) {

	    // 2. FIFO 엔트리 수 확인
	    fifo_count = max30123_get_fifo_count();

#if _EIS_FIFO_INFO_DEBUG_
	    swmLogInfo("[CA] FIFO count=%d\r\n", fifo_count);
#endif

	    if (fifo_count == 0u) {					// FIFO가 없거나 너무 많은 숫자가 들어 오면

#if _EIS_FIFO_INFO_DEBUG_
	        swmLogInfo("[CA] ERR: FIFO empty\r\n");
#endif
	        return 0u;
	    }

	    out->n_step = 0;

	    // 3. FIFO 읽기 루프
	    while(fifo_count > 0) {
	        max30123_read_fifo_data(&max30123_fifo);

	        if (max30123_fifo.meas_id != CA_MEAS_M1) {		// M1(Chrono A) 데이터만 처리. M0 PSTAT 값은 SKIP
	            continue;
	        }

	        nA = ca_code_to_nA(max30123_fifo.adc_val);

	        switch(max30123_fifo.data_type) {
	        	case FIFO_TYPE_WE1_PSTAT_CURR:
	        		break;

	        	case FIFO_TYPE_WE1_PRE:
					break;

				case FIFO_TYPE_WE1_STEP:
					out->step_nA[out->n_step++] = nA;
					break;

				default:
					break;
	        }

	#if _EIS_FIFO_INFO_DEBUG_
	        swmLogInfo("FIFO : [%d]--> 0x%02X, %d\r\n", fifo_count, max30123_fifo.data_type, (int16_t)max30123_fifo.adc_val);
	#endif
	    	fifo_count--;
	    }

	    if (out->n_step == 0u) {
	#if _EIS_FIFO_INFO_DEBUG_
	        swmLogInfo("[CA] ERR: 샘플 부족\r\n");
	#endif
	        return 0u;
	    }
	#if _EIS_FIFO_INFO_DEBUG_
	        swmLogInfo("max30123_chrono_A_measurement success\r\n");
	#endif

		return 1;

	}

	return 0;
}


/************************************************************************************
 *	#3-2. max30123 chronoamperometry measurement...manual mode
 ************************************************************************************/
uint8_t max30123_chrono_A_measurement_manual_mode(chrono_a_raw_t *out)
{
    uint8_t  ok = 0u;

#if 0
    const chrono_A_cfg_t *c = ca_active_cfg;
    uint8_t  saved_m1, cmode, status;
    uint16_t fifo_count, i, need;
    uint32_t elapsed = 0u;
    uint32_t timeout_ms;

    if ((out == NULL) || (c == NULL)) { return 0u; }

    out->n_step  = 0u;
    out->isp_sec = c->isp_sec;
    out->rate    = (uint8_t)ca_active_idx;

  //  need       = c->
    timeout_ms = c->conv_sec + CA_MANUAL_MARGIN_MS;

    // 1. 진행 중인 변환이 있으면 정지 (CONVERT 1->1 은 무시된다)
    cmode = spidrv_read_max30123_reg_action(MAX30123_REG_CONVERT_MODE);
    if ((cmode & CONVERT_MODE_CONVERT) != 0u) {
        spidrv_write_max30123_reg_action(MAX30123_REG_CONVERT_MODE, 0x00u);
        do {
            status = spidrv_read_max30123_reg_action(MAX30123_REG_STATUS1);
            if ((status & STATUS1_SEQ_RDY) != 0u) { break; }
            max30123_delay_ms(1u);
            elapsed++;
        } while (elapsed < CA_SEQ_STOP_TMOUT_MS);
        elapsed = 0u;
    }

    // 2. 슬롯 구성 : M1 = Chrono A
    saved_m1 = spidrv_read_max30123_reg_action(MAX30123_REG_M1_CFG);
    spidrv_write_max30123_reg_action(MAX30123_REG_M1_CFG, (uint8_t)(MN_MODE_CHRONO_A << MN_MODE_SHIFT));

    // 3. FIFO flush
    spidrv_write_max30123_reg_action(MAX30123_REG_FIFO_CONFIG2,
                                     FIFO_CFG2_FLUSH_FIFO
                                   | FIFO_CFG2_FIFO_STAT_CLR
                                   | FIFO_CFG2_A_FULL_TYPE);

    // 4. 단발 변환
    max30123_delay_ms(1u);              /* CONVERT 0->1 은 4 SR_CLK 이후 */
    spidrv_write_max30123_reg_action(MAX30123_REG_CONVERT_MODE,
                                     CONVERT_MODE_CONVERT);

    // 5. CONVERT 자동 clear 대기
    do {
        SYS_WATCHDOG_REFRESH();

        max30123_delay_ms(CA_POLL_INTERVAL_MS);
        elapsed += CA_POLL_INTERVAL_MS;

        fifo_count = max30123_get_fifo_count();
        if (fifo_count >= need) { break; }

    } while (elapsed < timeout_ms);

    spidrv_write_max30123_reg_action(MAX30123_REG_CONVERT_MODE, CONVERT_MODE_STOP);
    spidrv_write_max30123_reg_action(MAX30123_REG_M1_CFG, saved_m1);

    // 6. FIFO 파싱
    if (fifo_count > MAX30123_FIFO_DEPTH) { fifo_count = MAX30123_FIFO_DEPTH; }

    for (i = 0u; i < fifo_count; i++) {
        if (max30123_read_fifo_data(&max30123_fifo) == 0) {	break;	}

        if ((max30123_fifo.meas_id   != CA_MEAS_M1) ||
            (max30123_fifo.data_type != FIFO_TYPE_WE1_STEP)) {	continue;	}

        if (out->n_step < need) {
            out->step_nA[out->n_step++] = ca_code_to_nA(max30123_fifo.adc_val);
        }
    }

    ok = (out->n_step == (need-1)) ? 1u : 0u;

#endif

    return ok;
}

/*******************************************************************
 *  max30123_impedance_measurement
 *
 *  Chrono A STEP + POST 샘플로 10Hz DFT 수행 → Z 계산
 *
 *  전압 파형 정의:
 *    k = 0 ~ n_step-1 : V = +CA_VSTEP_MV (+30mV)
 *    k = n_step ~ N-1 : V =  CA_VPOST_MV  (0mV, baseline 복귀)
 *
 *  DFT (e^(-j2π×f×k×ISP)):
 *    X_real = Σ x[k] × cos(2π × f × k × ISP)
 *    X_imag = Σ x[k] × sin(2π × f × k × ISP)   (부호 주의: -j → -sin)
 *
 *  Z 계산 (복소수 나눗셈):
 *    Z = V_DFT / I_DFT
 *    Z_real = (V_re×I_re + V_im×I_im) / |I|²  × 1e6  [Ω]
 *    Z_imag = (V_im×I_re - V_re×I_im) / |I|²  × 1e6  [Ω]
 *    (×1e6: mV/nA → V/A = Ω)
 ********************************************************************/

uint8_t max30123_impedance_calcualtion(const chrono_a_raw_t *in, impedance_result_t *out)
{
#if 0

    float   v_re = 0.0f, v_im = 0.0f;
    float   i_re = 0.0f, i_im = 0.0f;
    float   i_mag_sq;
    float   phase;
    float   v_k, i_k;
    float   FREQ_HZ, ISP_SEC;

    uint8_t k;
    uint8_t in_step;
    uint8_t cycle, step_pos, post_k, post_pos;
    uint32_t t_idx;  										/* 절대 시간 인덱스 */

    uint8_t n_per_cycle = CA_STEP_COUNT + CA_POST_COUNT;  	/* 11 */
    uint8_t n_total     = in->n_step + in->n_post;        	/* 44 */

    double z_real, z_imag, z_mag, z_phase_deg;

    if (out == NULL || n_total == 0u) {
        return 0u;
    }

    memset(out, 0, sizeof(*out));

    for (k = 0u; k < n_total; k++) {

        in_step = (k < in->n_step);   									// k<32: STEP,  k>=32: POST

        v_k = in_step ? CA_VSTEP_MV : CA_VPOST_MV;						// 전압
        i_k = in_step ? in->step_nA[k] : in->post_nA[k - in->n_step];	// 전류

        if (in_step) {
            cycle    = k / CA_STEP_COUNT;        	 					// 몇 번째 사이클
            step_pos = k % CA_STEP_COUNT;         						// 사이클 내 위치
            t_idx    = (uint32_t)cycle * n_per_cycle + step_pos;

        } else {
            post_k   = k - in->n_step;
            cycle    = post_k / CA_POST_COUNT;
            post_pos = post_k % CA_POST_COUNT;
            t_idx    = (uint32_t)cycle * n_per_cycle + CA_STEP_COUNT + post_pos;
        }

#if 0
        phase = 2.0f * M_PI * CA_FREQ_HZ * (float)t_idx * CA_ISP_SEC;
#else
        FREQ_HZ = chrono_setup[max30123_chrono_A_count].freq_hz;
        ISP_SEC = chrono_setup[max30123_chrono_A_count].isp_sec;
        phase = 2.0f * M_PI * FREQ_HZ * (float)t_idx * ISP_SEC;
#endif

#if 0 //#if _EIS_FIFO_INFO_DEBUG_
		swmLogInfo("Freq = " LOG_FLOAT_MARKER ",  isp sec = " LOG_FLOAT_MARKER "\r\n",
					LOG_FLOAT(FREQ_HZ), LOG_FLOAT(ISP_SEC));
		max30123_delay_ms(1);
#endif

        v_re += v_k * cosf(phase);
        v_im -= v_k * sinf(phase);

        i_re += i_k * cosf(phase);
        i_im -= i_k * sinf(phase);

#if _IMPEDANCE_INFO_DEBUG_
        swmLogInfo("[DFT] k=%2d  V=" LOG_FLOAT_MARKER " mV  I=" LOG_FLOAT_MARKER " nA\r\n", k, LOG_FLOAT(v_k), LOG_FLOAT(i_k));
        max30123_delay_ms(1);
#endif
    }

#if _IMPEDANCE_INFO_DEBUG_
    swmLogInfo("[DFT] V_re=" LOG_FLOAT_MARKER "  V_im=" LOG_FLOAT_MARKER " mV\r\n", LOG_FLOAT(v_re), LOG_FLOAT(v_im));
    swmLogInfo("[DFT] I_re=" LOG_FLOAT_MARKER "  I_im=" LOG_FLOAT_MARKER " nA\r\n", LOG_FLOAT(i_re), LOG_FLOAT(i_im));
    max30123_delay_ms(1);
#endif

    i_mag_sq = (i_re * i_re) + (i_im * i_im);
    if (i_mag_sq < 1e-6f) {
#if _IMPEDANCE_INFO_DEBUG_
        swmLogInfo("[EIS] ERR: |I|≈0\r\n");
#endif
        return 0u;
    }

    z_real      = (v_re * i_re + v_im * i_im) / i_mag_sq * 1.0e6f;
    z_imag      = (v_im * i_re - v_re * i_im) / i_mag_sq * 1.0e6f;
    z_mag       = sqrtf(z_real * z_real + z_imag * z_imag);
    z_phase_deg = atan2f(z_imag, z_real) * 57.2957914;//(180.0f / M_PI);

    out->z_real 	= (int32_t)z_real;
    out->z_imag 	= (int32_t)z_imag;
    out->z_mag 		= (int32_t)z_mag;
    out->z_phase_deg= (int32_t)z_phase_deg;


#if _IMPEDANCE_RESULT_DEBUG_
    swmLogInfo("*****************************************\r\n");
    swmLogInfo("[%s] Z_real  = %ld Ohm\r\n", (char *)chrono_name[max30123_chrono_A_count], out->z_real);
    swmLogInfo("[%s] Z_imag  = %ld Ohm\r\n", (char *)chrono_name[max30123_chrono_A_count], out->z_imag);
    swmLogInfo("[%s] |Z|     = %ld Ohm\r\n", (char *)chrono_name[max30123_chrono_A_count], out->z_mag);
    swmLogInfo("[%s] Phase   = %ld deg\r\n", (char *)chrono_name[max30123_chrono_A_count], out->z_phase_deg);
    swmLogInfo("*****************************************\r\n\r\n");
#endif
#endif
    return 1u;
}


