 * 칩에 쓰지 않은 설정을 쓴 것처럼 믿게 되므로, 첫 실행에서 바로 드러나게 한다. */
const chrono_A_cfg_t *ca_active_cfg = NULL;
uint8_t               ca_active_idx = 0xFFu;

max30123_fifo_t      max30123_fifo;
impedance_result_t   impedance_result[CA_Z_FREQ_COUNT];
impedance_calendar_t impedance_calendar;

ca_range_state_e     ca_range_state  = CA_RANGE_PROBE;
uint8_t              ca_result_valid = 0u;
uint8_t 			 ca_set_done = 0u;

ca_fit_t             ca_fit;

/* STEP 누적기 — 드레인이 버스트 중간에 걸려도 다음 드레인에서 이어받는다 */
static chrono_a_raw_t ca_acc;

//static uint16_t cal_offset = 0u;

uint8_t max30123_measure_step = MAX30123_STEP_CALIBRATION;
uint8_t max30123_chrono_A_step = 0u;
uint8_t max30123_chrono_A_wait_count = 0;
uint16_t max30123_chrono_A_measure_tmout = 0;

uint8_t max30123_convert_mode = 0u;
uint16_t max30123_auto_mode_count = 0;

chron_A_sps_e max30123_chrono_A_count = 0;


static uint8_t  ca_target_row  = (uint8_t)CA_PROBE_ROW;
