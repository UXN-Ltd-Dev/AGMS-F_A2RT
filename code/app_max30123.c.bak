/*****************************************************************************
 *  max30123 WE Config
 *****************************************************************************/
void max30123_WE1_config_power_on(void)
{
	uint8_t regVal;

	/* FIFO Flush */
    spidrv_write_max30123_reg_action(MAX30123_REG_FIFO_WR_PTR, 0x00);
    spidrv_write_max30123_reg_action(MAX30123_REG_FIFO_RD_PTR, 0x00);

    regVal = spidrv_read_max30123_reg_action(MAX30123_REG_WE1_CFG1);
#if _EIS_FIFO_INFO_DEBUG_
    swmLogInfo("WE1_CFG1 : 0x%02X\r\n", regVal);
#endif

    regVal = spidrv_read_max30123_reg_action(MAX30123_REG_WE1_CFG2);
#if _EIS_FIFO_INFO_DEBUG_
    swmLogInfo("WE1_CFG2 : 0x%02X\r\n", regVal);
#endif

    regVal = spidrv_read_max30123_reg_action(MAX30123_REG_CE1_CFG);
#if _EIS_FIFO_INFO_DEBUG_
    swmLogInfo("CE1_CFG1 : 0x%02X\r\n", regVal);
#endif

    /* 레지스터 복원 */
	spidrv_write_max30123_reg_action(MAX30123_REG_WE1_CFG1, 0x82);	// WE1 CONFIG 1: Working Amp Enable
    spidrv_write_max30123_reg_action(MAX30123_REG_WE1_CFG2, 0xEA);	// WE1 CONFIG 2: Offset Always On = ON
    spidrv_write_max30123_reg_action(MAX30123_REG_CE1_CFG, 0x91);	// CE1 CONFIG: Counter Amp Enable
}



/* ==========================================================================
 * AUTO 모드 시퀀서
 * ========================================================================== */
void max30123_auto_mode_setup(void)
{
    /* INTB 미연결 → Hi-Z, 인터럽트 전부 비활성 */
    spidrv_write_max30123_reg_action(MAX30123_REG_GPIO_SETUP1, GPIO_SETUP1_INTB_UNUSED);
    spidrv_write_max30123_reg_action(MAX30123_REG_INT_EN1, 0x00u);
    spidrv_write_max30123_reg_action(MAX30123_REG_INT_EN2, 0x00u);

    /* tSSP = 120s */
    spidrv_write_max30123_reg_action(MAX30123_REG_AUTO_CLK_DIV_MSB, CA_AUTO_CLK_DIV_MSB);
    spidrv_write_max30123_reg_action(MAX30123_REG_AUTO_CLK_DIV_MID, CA_AUTO_CLK_DIV_MID);
    spidrv_write_max30123_reg_action(MAX30123_REG_AUTO_CLK_DIV_LSB, CA_AUTO_CLK_DIV_LSB);

    /* M0 = PSTAT, 매 tSSP.  ★ M0_MODE > 0 이어야 시퀀서가 시작된다 (M0 를 끄면 M1 도 멈춘다)
     * 0x70 의 기존 테이블 값 0x53 은 bits[7:6]=01 = I_CONV_OFFSET_ONLY 였다 —
     * 신호가 아니라 오프셋만 읽는 설정. signed(0xD3) 로 바로잡는다. */
    spidrv_write_max30123_reg_action(MAX30123_REG_M0_CFG,  CA_M0_CFG);
    spidrv_write_max30123_reg_action(MAX30123_REG_M0_CONV, CA_M0_CONV);
    spidrv_write_max30123_reg_action(MAX30123_REG_M0_AVG,  CA_M0_AVG);

    /* M1 = Chrono A, SRD 로 스킵 → 60분 주기 */
    spidrv_write_max30123_reg_action(MAX30123_REG_M1_CFG, CA_M1_CFG);

    /* 사용하지 않는 슬롯은 명시적으로 끈다 */
    spidrv_write_max30123_reg_action(MAX30123_REG_M2_CFG, 0x00u);
    spidrv_write_max30123_reg_action(MAX30123_REG_M3_CFG, 0x00u);
    spidrv_write_max30123_reg_action(MAX30123_REG_M4_CFG, 0x00u);

    /* 프로브 행으로 시작 */
    max30123_M1_chrono_A_sps(CA_PROBE_ROW);
    ca_range_state          = CA_RANGE_PROBE;
    max301123_chrono_A_count = CA_PROBE_ROW;
}


/* 다음 tSSP 경계를 기다리지 않고 시퀀스를 즉시 재시작.
 * TODO: SEQ_RESTART 동작을 벤치에서 확인. 효과가 없으면 그냥 다음 tSSP 를
 *       기다리면 된다 (deadline 에 CA_TSSP_SEC 가 이미 포함되어 있다). */
static void ca_seq_restart(void)
{
    uint8_t v = spidrv_read_max30123_reg_action(MAX30123_REG_CONVERT_MODE);
    spidrv_write_max30123_reg_action(MAX30123_REG_CONVERT_MODE,
                                     (uint8_t)(v | CONVERT_MODE_SEQ_RESTART));
}


void max30123_auto_mode_start(void)
{
    ca_acc.n_step   = 0u;
    ca_result_valid = 0u;

    max30123_fifo_flush();
    max30123_delay_ms(1u);                      /* CONVERT 0→1 은 4 SR_CLK 이후 */

    spidrv_write_max30123_reg_action(MAX30123_REG_CONVERT_MODE,
                                     CONVERT_MODE_AUTO | CONVERT_MODE_CONVERT);

#if _MAX30123_INFO_DEBUG_
    {
        uint8_t st = spidrv_read_max30123_reg_action(MAX30123_REG_STATUS1);
        if ((st & STATUS1_INVALID_CFG) != 0u) {
            /* 측정 시간 > tSSP 이거나 CONV_TIME ≥ ISP */
            swmLogInfo("[CA] ERR: INVALID_CFG (st=%02X)\r\n", (unsigned)st);
        }
    }
#endif
}

void max30123_auto_mode_stop(void)
{
    spidrv_write_max30123_reg_action(MAX30123_REG_CONVERT_MODE, CONVERT_MODE_STOP);
}

void max30123_reg_dump(void)
{
    swmLogInfo("[CHK] 35=%02X 37=%02X 38=%02X 39=%02X 3A=%02X 3B=%02X 3C=%02X\r\n",
        (unsigned)spidrv_read_max30123_reg_action(0x35),
        (unsigned)spidrv_read_max30123_reg_action(0x37),
        (unsigned)spidrv_read_max30123_reg_action(0x38),
        (unsigned)spidrv_read_max30123_reg_action(0x39),
        (unsigned)spidrv_read_max30123_reg_action(0x3A),
        (unsigned)spidrv_read_max30123_reg_action(0x3B),
        (unsigned)spidrv_read_max30123_reg_action(0x3C));
    max30123_delay_ms(1u);
    swmLogInfo("[CHK] 15=%02X 16=%02X 17=%02X 18=%02X 19=%02X "
               "60=%02X 62=%02X 64=%02X 70=%02X 72=%02X\r\n",
        (unsigned)spidrv_read_max30123_reg_action(0x15),
        (unsigned)spidrv_read_max30123_reg_action(0x16),
        (unsigned)spidrv_read_max30123_reg_action(0x17),
        (unsigned)spidrv_read_max30123_reg_action(0x18),
        (unsigned)spidrv_read_max30123_reg_action(0x19),
        (unsigned)spidrv_read_max30123_reg_action(0x60),
        (unsigned)spidrv_read_max30123_reg_action(0x62),
        (unsigned)spidrv_read_max30123_reg_action(0x64),
        (unsigned)spidrv_read_max30123_reg_action(0x70),
        (unsigned)spidrv_read_max30123_reg_action(0x72));
    /* 기대값: 35=05  37=C8  38=63  39~3B=00  3C=64
     *         15=3C 16=00 17=00  60=03  62=20  64=5D  70=D3
     * ★ 35 가 05 가 아니면 측정하지 말 것 — 모든 R 이 비례해서 틀린다 */
}

/* ==========================================================================
 * 3점 프로브 — I∞ 가 소거되는 τ 추정
 *
 *    (I₁−I₂)/(I₂−I₃) = e^(Δ/τ)      ← I∞ 가 완전히 사라진다
 *    τ = Δ / ln[(I₁−I₂)/(I₂−I₃)]
 *
 *  창이 τ 를 덮지 못해도 성립한다. 1.56s 창으로 2.35s τ 를 복원 검증.
 *  정확도 약 26% — 측정값이 아니라 레인지 파인더다 (행이 2배 간격).
 *  반환 0.0f = "τ ≪ Δ" → 그 버스트를 직접 피팅하거나 한 단 내린다.
 * ========================================================================== */
float ca_probe_tau(const chrono_a_raw_t *in)
{
    float   i1 = 0.0f, i2 = 0.0f, i3 = 0.0f;
    float   num, den, d;
    uint8_t k, gap;

    if ((in == NULL) || (in->n_step < (3u * CA_PROBE_BLK))) { return 0.0f; }

    gap = (uint8_t)((in->n_step - CA_PROBE_BLK) / 2u);      /* 등간격 보장 */

    for (k = 0u; k < CA_PROBE_BLK; k++) {
        i1 += in->step_nA[k];
        i2 += in->step_nA[gap + k];
        i3 += in->step_nA[(uint16_t)(2u * gap) + k];
    }
    i1 /= (float)CA_PROBE_BLK;
    i2 /= (float)CA_PROBE_BLK;
    i3 /= (float)CA_PROBE_BLK;

    num = i1 - i2;
    den = i2 - i3;

    if (den < CA_PROBE_DEN_NA) { return 0.0f; }     /* 노이즈 이하 → τ 가 작다 */
    if (num <= den)            { return 0.0f; }     /* 비 ≤ 1 → 지수 감쇠 아님 */

    d = logf(num / den);
    if (d < 1e-4f) { return 0.0f; }

    return ((float)gap * in->isp_sec) / d;
}

/* τ 에 맞는 행 : τ ∈ [5·ISP, 10·ISP] */
static chron_A_sps_e ca_row_for_tau(float tau)
{
    uint8_t i;

    if (tau <= 0.0f) { return (chron_A_sps_e)0; }

    for (i = 0u; i < (uint8_t)CHRONO_SPS_COUNT; i++) {
        if (tau <= (chrono_A_cfg[i].isp_sec * 10.0f)) { return (chron_A_sps_e)i; }
    }
    return (chron_A_sps_e)((uint8_t)CHRONO_SPS_COUNT - 1u);
}

/* ==========================================================================
 * 단일 지수 피팅
 *   I(t) = I∞ + (I₀−I∞)·e^(−t/τ)
 *   R[Ω] = V[mV] / I[nA] × 1e6
 *
 *   ★ 전제 : T ≥ 10τ.  레인지가 맞으면 T/τ ∈ [10,20] 이라 I∞ 바이어스 1% 수준.
 *     레인지가 틀리면 I∞ 가 무너진다 (T/τ=1.56 에서 +104%).
 * ========================================================================== */
uint8_t max30123_step_fit(const chrono_a_raw_t *in, ca_fit_t *out)
{
    uint8_t i, cnt = 0u, n_fit;
    float   y, t, sum = 0.0f;
    float   sx = 0.0f, sy = 0.0f, sxx = 0.0f, sxy = 0.0f;
    float   den, slope, icept, i0, rpar, t_off;

    if ((in == NULL) || (out == NULL))                  { return 0u; }
    if (in->n_step <= (CA_IINF_AVG_N + CA_FIT_MIN_PTS)) { return 0u; }

    memset(out, 0, sizeof(*out));                       /* 부분 기록 방지 */
    out->n_exp = 1u;

    /* 샘플 i 는 적분 구간 [i·ISP, i·ISP+conv] 의 평균 → 대표 시각은 구간 중심.
     * 공통 오프셋이라 τ 에는 영향 없고 I₀(=Rs) 만 보정된다. */
    t_off = in->conv_sec * 0.5f;

    /* ---- 1. I∞ : 꼬리 평균 ---- */
    for (i = (uint8_t)(in->n_step - CA_IINF_AVG_N); i < in->n_step; i++) {
        sum += in->step_nA[i];
    }
    out->i_inf_nA = sum / (float)CA_IINF_AVG_N;
    if (out->i_inf_nA < 0.5f) { return 0u; }

    /* ---- 2. ln(I − I∞) 선형 회귀 : 앞 60% ---- */
    n_fit = (uint8_t)(((uint16_t)in->n_step * CA_FIT_FRAC_NUM) / CA_FIT_FRAC_DEN);

    for (i = 0u; i < n_fit; i++) {
        y = in->step_nA[i] - out->i_inf_nA;
        if (y <= CA_Y_FLOOR_NA) { continue; }
        t = ((float)i * in->isp_sec) + t_off;
        y = logf(y);
        sx += t;  sy += y;  sxx += (t * t);  sxy += (t * y);
        cnt++;
    }
    if (cnt < CA_FIT_MIN_PTS) { return 0u; }

    den = ((float)cnt * sxx) - (sx * sx);
    if ((den > -1e-3f) && (den < 1e-3f)) { return 0u; }     /* float32 상쇄 바닥 */

    slope = (((float)cnt * sxy) - (sx * sy)) / den;         /* = −1/τ */
    icept = (sy - (slope * sx)) / (float)cnt;               /* = ln(I₀−I∞) */

    if (slope >= -1e-4f) { return 0u; }                     /* τ 발산 차단 */

    out->tau_sec[0] = -1.0f / slope;
    out->a_nA[0]    = expf(icept);

    i0 = out->i_inf_nA + out->a_nA[0];
    if ((i0 <= out->i_inf_nA) || (i0 > (CA_FS_NA * 2.0f))) { return 0u; }
    out->i0_nA = i0;

    /* ---- 3. R, C ---- */
    out->r_total_ohm = (CA_VSTEP_MV / out->i_inf_nA) * 1.0e6f;
    out->rs_ohm      = (CA_VSTEP_MV / i0)            * 1.0e6f;
    out->r1_ohm      = out->r_total_ohm - out->rs_ohm;      /* Rct */
    if (out->r1_ohm < 1.0f) { return 0u; }

    rpar        = (out->rs_ohm * out->r1_ohm) / out->r_total_ohm;   /* Rs ∥ Rct */
    out->c1_F   = out->tau_sec[0] / rpar;                           /* Cdl */

    return 1u;
}

/* ==========================================================================
 * Z(ω) — 등가회로 가정 없이 라플라스로
 *
 *   전압 스텝 ΔV·u(t) →  Z(jω) = ΔV / (jω·I(jω))
 *
 *   Y ≡ jω·I(jω)
 *   Y_real = I∞ + Σ A_k · (ωτ_k)² / [1+(ωτ_k)²]
 *   Y_imag =      Σ A_k · (ωτ_k)  / [1+(ωτ_k)²]
 *   Z_real =  ΔV·Y_real / |Y|² × 1e6
 *   Z_imag = −ΔV·Y_imag / |Y|² × 1e6
 *
 *   지수 개수에 무관. ω→0 에서 R_total, ω→∞ 에서 Rs (극한 일치 확인).
 *   Randles 식과 0.1Hz 에서 대조 검증 완료 (23015/−17842 vs 23006/−17864 Ω).
 *   expf/logf 불필요 — 곱셈 + sqrtf + atan2f 각 1회.
 * ========================================================================== */
uint8_t max30123_z_from_fit(const ca_fit_t *f, float freq_hz, impedance_result_t *out)
{
    float   w, yr, yi, d, zr, zi, wt, wt2;
    uint8_t k;

    if ((f == NULL) || (out == NULL) || (freq_hz <= 0.0f)) { return 0u; }
    if ((f->n_exp == 0u) || (f->n_exp > CA_NEXP_MAX))      { return 0u; }

    w  = 6.28318531f * freq_hz;
    yr = f->i_inf_nA;
    yi = 0.0f;

    for (k = 0u; k < f->n_exp; k++) {
        if (f->tau_sec[k] <= 0.0f) { continue; }
        wt  = w * f->tau_sec[k];
        wt2 = wt * wt;
        d   = 1.0f + wt2;
        yr += f->a_nA[k] * (wt2 / d);
        yi += f->a_nA[k] * (wt  / d);
    }

    d = (yr * yr) + (yi * yi);                      /* |Y|² [nA²] */
    if (d < 1e-6f) { return 0u; }

    zr =  (CA_VSTEP_MV * yr / d) * 1.0e6f;          /* mV/nA × 1e6 = Ω */
    zi = -(CA_VSTEP_MV * yi / d) * 1.0e6f;

    out->z_real      = (int32_t)zr;
    out->z_imag      = (int32_t)zi;
    out->z_mag       = (int32_t)sqrtf((zr * zr) + (zi * zi));
    out->z_phase_deg = (int32_t)(atan2f(zi, zr) * 57.29578f);

    return 1u;
}

/* 행별 유효 대역 안에서 Z 주파수 3점을 고른다.
 *   f_max ≈ 1/(2π·ISP),  f_min ≈ 1/(2π·T),  T = 100·ISP → 대역비 100 */
void ca_z_freqs(float isp_sec, float *f)
{
    float fmax = 1.0f / (6.28318531f * isp_sec);
    f[0] = fmax / 50.0f;
    f[1] = fmax / 10.0f;
    f[2] = fmax /  2.0f;
}

/* ==========================================================================
 * 한 세트(STEP 100개) 완성 시 처리
 * ========================================================================== */
void ca_on_set_complete(void)
{
    float         fz[CA_Z_FREQ_COUNT];
    float         tau_p;
    uint8_t       i, fit_ok;
    chron_A_sps_e want;

    ca_acc.rate     = ca_active_idx;
    ca_acc.isp_sec  = ca_active_cfg->isp_sec;
    ca_acc.conv_sec = ca_active_cfg->conv_sec;

    ca_set_done = 1u;           /* ★ 모든 경로에서 세운다. 이게 없어서
                                 *   case 1 이 영원히 플래그를 못 봤다 */

    /* ISP 변경 직후 첫 세트는 깨져 있을 수 있으므로 폐기 */
    if (ca_range_state == CA_RANGE_SETTLING) {
        ca_range_state = (ca_active_idx == (uint8_t)CA_PROBE_ROW)
                       ? CA_RANGE_PROBE : CA_RANGE_LOCKED;
        ca_acc.n_step   = 0u;
        ca_result_valid = 0u;
        return;
    }

    fit_ok = max30123_step_fit(&ca_acc, &ca_fit);

    /* ---- 프로브 : I∞ 없이 τ 추정 → 다음 행 결정 ---- */
    if (ca_range_state == CA_RANGE_PROBE) {
        tau_p = ca_probe_tau(&ca_acc);
        if ((tau_p == 0.0f) && (fit_ok != 0u)) {
            tau_p = ca_fit.tau_sec[0];              /* τ 가 작다 → 이 버스트가 유효 */
        }
        want = ca_row_for_tau(tau_p);

#if _MAX30123_INFO_DEBUG_
        swmLogInfo("[CA] probe tau=" LOG_FLOAT_MARKER "s -> row %u (cur %u)\r\n",
                   LOG_FLOAT(tau_p), (unsigned)want, (unsigned)ca_active_idx);
#endif
        if ((uint8_t)want != ca_active_idx) {
            max30123_chrono_A_count = want;         /* 레지스터는 case 0 에서 */
            ca_range_state  = CA_RANGE_LOCKED;
            ca_result_valid = 0u;
            ca_acc.n_step   = 0u;
            return;
        }
        ca_range_state = CA_RANGE_LOCKED;           /* 프로브 행이 이미 맞다 */
    }

    /* ---- 피팅 실패 → 다음 회차엔 프로브부터 ---- */
    if (fit_ok == 0u) {
        memset(impedance_result, 0, sizeof(impedance_result));
        ca_result_valid         = 0u;
        ca_acc.n_step           = 0u;
        max30123_chrono_A_count = CA_PROBE_ROW;
        ca_range_state          = CA_RANGE_PROBE;
#if _MAX30123_INFO_DEBUG_
        swmLogInfo("[CA] fit reject -> reprobe\r\n");
#endif
        return;
    }

    /* ---- τ 가 창을 벗어났으면 행 이동 후 재측정 ---- */
    if ((ca_fit.tau_sec[0] < (ca_acc.isp_sec *  5.0f)) ||
        (ca_fit.tau_sec[0] > (ca_acc.isp_sec * 10.0f))) {
        want = ca_row_for_tau(ca_fit.tau_sec[0]);
        if ((uint8_t)want != ca_active_idx) {
            max30123_chrono_A_count = want;
            ca_result_valid = 0u;
            ca_acc.n_step   = 0u;
            return;
        }
    }

    /* ---- 유효 결과 ---- */
    ca_z_freqs(ca_acc.isp_sec, fz);
    for (i = 0u; i < CA_Z_FREQ_COUNT; i++) {
        max30123_z_from_fit(&ca_fit, fz[i], &impedance_result[i]);
    }
    ca_result_valid = 1u;

#if _IMPEDANCE_RESULT_DEBUG_
    swmLogInfo("[CA] row=%u I0=" LOG_FLOAT_MARKER " Iinf=" LOG_FLOAT_MARKER
               " tau=" LOG_FLOAT_MARKER "\r\n",
               (unsigned)ca_acc.rate, LOG_FLOAT(ca_fit.i0_nA),
               LOG_FLOAT(ca_fit.i_inf_nA), LOG_FLOAT(ca_fit.tau_sec[0]));
    max30123_delay_ms(1u);
    swmLogInfo("[CA] Rs=" LOG_FLOAT_MARKER "k Rct=" LOG_FLOAT_MARKER
               "k Rt=" LOG_FLOAT_MARKER "k Cdl=" LOG_FLOAT_MARKER "uF\r\n",
               LOG_FLOAT(ca_fit.rs_ohm      * 0.001f),
               LOG_FLOAT(ca_fit.r1_ohm      * 0.001f),
               LOG_FLOAT(ca_fit.r_total_ohm * 0.001f),
               LOG_FLOAT(ca_fit.c1_F * 1.0e6f));
    max30123_delay_ms(1u);
    for (i = 0u; i < CA_Z_FREQ_COUNT; i++) {
        swmLogInfo("[Z] f=" LOG_FLOAT_MARKER "Hz Zr=%ld Zi=%ld |Z|=%ld ph=%ld\r\n",
                   LOG_FLOAT(fz[i]),
                   (long)impedance_result[i].z_real, (long)impedance_result[i].z_imag,
                   (long)impedance_result[i].z_mag,  (long)impedance_result[i].z_phase_deg);
        max30123_delay_ms(1u);
    }
#endif

    ca_acc.n_step = 0u;
}

/* ==========================================================================
 * FIFO 드레인 — 블로킹 없음. 글루코스와 impedance 를 태그로 분류한다.
 *
 *  이 함수 하나가 기존 manual/auto 측정 함수 4개를 대체한다.
 *  MCU 는 자기 주기(BLE 깨우기)에 이것만 호출하고 다시 잔다.
 * ========================================================================== */
void max30123_fifo_drain(void)
{
    uint8_t  buf[2], ovf;
    uint16_t cnt, i;
    float    we;

    if (ca_active_cfg == NULL) { return; }      /* cfg_apply() 전에 호출됨 */

    spidrv_read_max30123_reg_buffer(MAX30123_REG_FIFO_COUNTER1, buf, 2);
    ovf = (uint8_t)(buf[0] & 0x7Fu);
    cnt = (uint16_t)(((uint16_t)(buf[0] & 0x80u) << 1) | buf[1]);

    /* 유실이 있으면 누적기의 위상이 어긋나 이후 모든 fit 이 두 버스트의 혼합이 된다.
     * OVF 는 FIFO_COUNTER1 하위 7비트에 같이 오므로 SPI 추가 비용이 0. */
    if (ovf != 0u) {
#if _MAX30123_INFO_DEBUG_
        swmLogInfo("[CA] FIFO OVF=%u → discard\r\n", (unsigned)ovf);
#endif
        ca_acc.n_step = 0u;
        max30123_fifo_flush();

        return;
    }

    if (cnt == 0u) { return; }                  /* 바로 복귀 → sleep */
    if (cnt > MAX30123_FIFO_DEPTH) { cnt = MAX30123_FIFO_DEPTH; }

    for (i = 0u; i < cnt; i++) {
        if (max30123_read_fifo_data(&max30123_fifo) == 0) { break; }

        /* ---- M0 : 글루코스(PSTAT) ---- */
        if (max30123_fifo.meas_id == CA_MEAS_M0) {
            if (max30123_fifo.data_type == FIFO_TYPE_WE1_PSTAT_CURR) {
                /* chrono 직후 N개는 전극 교란 때문에 버린다.
                 * 카운트만 줄이고 push 하면 의미가 없으므로 여기서 걸러낸다 */
                if (max30123_chrono_A_wait_count > 0u) {
                    max30123_chrono_A_wait_count--;
                } else {
                    we = dc_code_to_nA(max30123_fifo.adc_val);
                    rb_push(&ring_buff, we, we);
#if _EIS_FIFO_INFO_DEBUG_
                    swmLogInfo("[DC] " LOG_FLOAT_MARKER " nA\r\n", LOG_FLOAT(we));
#endif
            }
            continue;
        }

        /* ---- M1 : Chrono A STEP ---- */
        if (max30123_fifo.meas_id != CA_MEAS_M1)               { continue; }
        if (max30123_fifo.data_type != FIFO_TYPE_WE1_STEP)     { continue; }

        if (ca_acc.n_step < CA_STEP_COUNT) {
            ca_acc.step_nA[ca_acc.n_step] = ca_code_to_nA(max30123_fifo.adc_val);
            ca_acc.n_step++;
        }

        if (ca_acc.n_step >= CA_STEP_N) {
            ca_on_set_complete();
            break;                  /* ★ flush 된 FIFO 를 더 읽지 않는다 */
        }
    }
}


/* ---- [C8] 글루코스 발행 ------------------------------------------------- */
static void ca_dc_publish(void)
{
    if (calendar.update != DATE_TIME_UPDATE_SUCCESS) { return; }

    if (ring_buff.count >= CA_DC_AVG_N) {
        rb_flush_trimmed_average(&ring_buff,
                                 &device_info.we1_current,
                                 &device_info.we2_current);
        append_Potentiostat_data();
        max30123_send_attribute(APP_ATTR_SEND_AGMS_VALUE);
    }
}

///////////////////////////////////////////////////////////////////////////////////////
///////////////////////////////////////////////////////////////////////////////////////
//
//	max30123
//

/**************************************************************************************
 * MAX30123 단계별 진행 상태..
 **************************************************************************************/
void max30123_measure_Process(void)
{
	float we_current;
	uint16_t cal = 0u;

	if(read_custom_irq()!=1)
		return;

	clear_custom_irq();

	switch(max30123_measure_step) {
		case MAX30123_STEP_CALIBRATION:
			if(max30123_measure_calibration(&cal)) {					// 보정이 되어야 다음 단계로 넘어 간다...
				max30123_measure_step = MAX30123_STEP_DC_CURRENT;
			}
			break;

		case MAX30123_STEP_DC_CURRENT:
			if(max30123_measure_DC_manual_mode(&we_current)) {
				if(calendar.update == DATE_TIME_UPDATE_SUCCESS) {
					if(max30123_chrono_A_wait_count>0)	max30123_chrono_A_wait_count--;
					if(max30123_chrono_A_wait_count==0) {	// chrono_A 측정 이후 FIFO 안정화를 위해 6번 데이터를 버린다...10초 --> 6회 ==> 60초
						rb_push(&ring_buff, we_current, we_current);

#if _EIS_FIFO_INFO_DEBUG_
    swmLogInfo("DC_CURRENT : ("LOG_FLOAT_MARKER")nA, [%.2f]nA, [%d]\r\n", LOG_FLOAT(we_current), we_current, ring_buff.count);
#endif

						if(ring_buff.count >= 6) {			// 10초 간격으로
							rb_flush_trimmed_average(&ring_buff, &device_info.we1_current, &device_info.we2_current);
							append_Potentiostat_data();

							max30123_send_attribute(APP_ATTR_SEND_AGMS_VALUE);
						}
					}
				}
			}
			break;

		case MAX30123_STEP_CHRONO_A:
			max30123_measure_ChronoAmperometry();
			break;

		default:
			break;
	}
}

/***********************************************************************************************************************
 *  MAX30123 CA (ChronoAmperometry)
 ***********************************************************************************************************************/
void max30123_measure_ChronoAmperometry(void)
{
	switch(max30123_chrono_A_step) {
/* ---- 0 : SPS 적용 + M1 enable ---- */
		case 0:
			max30123_M1_chrono_A_sps((chron_A_sps_e)max30123_chrono_A_count);

			ca_range_state = (max30123_chrono_A_count == (uint8_t)CA_PROBE_ROW) ? CA_RANGE_PROBE : CA_RANGE_LOCKED;
			ca_acc.n_step   = 0u;
	        ca_set_done     = 0u;               /* ★ [B] */
			ca_result_valid = 0u;

			max30123_fifo_flush();

			spidrv_write_max30123_reg_action(MAX30123_REG_M1_CFG, CA_M1_CFG_ON);
			ca_seq_restart();

			ca_wait_s     = 0u;
			ca_deadline_s = (uint16_t)(CA_TSSP_SEC
						  + ((ca_active_cfg->duration_ms + 999u) / 1000u)
						  + CA_WAIT_MARGIN_SEC);

#if _MAX30123_INFO_DEBUG_
		swmLogInfo("[CA] arm row=%u deadline=%us\r\n",
				   (unsigned)ca_target_row, (unsigned)ca_deadline_s);
#endif
		        max30123_chrono_A_step = 1u;
		        Call_Custom_NTF_Timeout(CA_POLL_SEC);
		       break;

/* ---- 1 : STEP 100개 모이기 대기 ---- */
		case 1:
	        max30123_fifo_drain();              /* 완성되면 내부에서 ca_on_set_complete() */

	        if (ca_set_done != 0u) {            /* ★ [B] n_step==0 이 아니라 플래그로 */
	            max30123_chrono_A_step = 2u;
	            Call_Custom_NTF_Timeout(1u);
	            break;
	        }

	        if (ca_acc.n_step == 0u) {          /* 세트 처리 완료 (성공이든 재측정이든) */
	            max30123_chrono_A_step = 2u;
	            Call_Custom_NTF_Timeout(1u);
	            break;
	        }

	        ca_wait_s = (uint16_t)(ca_wait_s + CA_POLL_SEC);
	        if (ca_wait_s >= ca_deadline_s) {
	#if _MAX30123_INFO_DEBUG_
	            swmLogInfo("[CA] timeout n_step=%u/%u (%us)\r\n",
	                       (unsigned)ca_acc.n_step, (unsigned)CA_STEP_N,
	                       (unsigned)ca_wait_s);
	#endif
	            ca_result_valid = 0u;
	            max30123_chrono_A_step = 2u;
	            Call_Custom_NTF_Timeout(1u);
	            break;
	        }
	        Call_Custom_NTF_Timeout(CA_POLL_SEC);
			break;

		case 2:
	        spidrv_write_max30123_reg_action(MAX30123_REG_M1_CFG, CA_M1_CFG_OFF);
	        ca_acc.n_step = 0u;

	        if (ca_result_valid != 0u) {
	            impedance_calendar.epoch = get_epoch_time(&calendar);
	            max30123_send_attribute(APP_ATTR_SEND_AGMS_VALUE);
	            ca_retry = 0u;
	            max30123_chrono_A_step = 3u;
	            Call_Custom_NTF_Timeout(1u);
	            break;
	        }

	        /* 레인지가 바뀌었거나 실패 → 전극 이완 후 재측정 */
	        if (ca_retry < CA_RETRY_MAX) {
	            ca_retry++;
	#if _MAX30123_INFO_DEBUG_
	            swmLogInfo("[CA] retry %u/%u row=%u\r\n",
	                       (unsigned)ca_retry, (unsigned)CA_RETRY_MAX,
	                       (unsigned)ca_target_row);
	#endif
	            max30123_chrono_A_step = 0u;
	            Call_Custom_NTF_Timeout(CA_RELAX_SEC);
	            break;
	        }

	        ca_retry = 0u;
	        max30123_chrono_A_step = 3u;
	        Call_Custom_NTF_Timeout(1u);

			break;

		case 3:																		//
	        /* chrono 스텝이 전극을 교란하므로 직후 PSTAT 몇 개를 버린다 */
	        max30123_chrono_A_wait_count = CA_DC_DISCARD_N;
	        max30123_chrono_A_step       = 0u;
	        max30123_measure_step        = MAX30123_STEP_DC_CURRENT;
	        Call_Custom_NTF_Timeout(1u);
			break;

		default:
	        spidrv_write_max30123_reg_action(MAX30123_REG_M1_CFG, CA_M1_CFG_OFF);
	        max30123_chrono_A_step = 0u;
			break;
	}
}

/************************************************************************************************************
 * CHRONOAMPEROMETRY FREQUENCE
 ************************************************************************************************************/
void max30123_M1_chrono_A_sps(chron_A_sps_e idx)
{
    const chrono_A_cfg_t *c;

    if ((uint8_t)idx >= (uint8_t)CHRONO_SPS_COUNT) { return; }
    c = &chrono_A_cfg[idx];

    spidrv_write_max30123_reg_action(MAX30123_REG_CHRONO_CLK_DIV_MSB,
                                     (uint8_t)((c->chrono_clk_div >> 8) & 0xFFu));

    spidrv_write_max30123_reg_action(MAX30123_REG_CHRONO_CLK_DIV_LSB,
                                     (uint8_t)( c->chrono_clk_div       & 0xFFu));

	spidrv_write_max30123_reg_action(MAX30123_REG_CHRONO_A_CFG1, CA_CFG1_VALUE); 	// PRE=4, POST_PULSE=0, AUTO_SUBTRACT=1, DELAY=24.8µs
	spidrv_write_max30123_reg_action(MAX30123_REG_CHRONO_A_CFG2, CA_STEP_SMP_REG);
	spidrv_write_max30123_reg_action(MAX30123_REG_CHRONO_A_CFG3, 0x00u);          	// REC    = 0
	spidrv_write_max30123_reg_action(MAX30123_REG_CHRONO_A_CFG4, 0x00u);          	// BLANK  = 1 ISP
	spidrv_write_max30123_reg_action(MAX30123_REG_CHRONO_A_CFG5, 0x00u);          	// REPEAT = 1회
    spidrv_write_max30123_reg_action(MAX30123_REG_CHRONO_A_CFG6, CA_CHRONO_A_CFG6);  /* FS 1024nA */

    spidrv_write_max30123_reg_action(MAX30123_REG_M1_CONV, c->m1_conv);
    spidrv_write_max30123_reg_action(MAX30123_REG_M1_AVG,  MEAS_AVE_1);

	ca_active_cfg = c;
	ca_active_idx = idx;

    /* ISP 변경이 버스트 중간에 들어가면 그 버스트가 깨진다.
     * FIFO 를 비우고 다음 한 세트를 폐기한다. */
    ca_acc.n_step = 0u;
    ca_range_state = CA_RANGE_SETTLING;

    max30123_fifo_flush();


#if _MAX30123_INFO_DEBUG_
    swmLogInfo("[CA] row=%u ISP=" LOG_FLOAT_MARKER "ms conv=%02X T=%lums\r\n",
               (unsigned)idx, LOG_FLOAT(c->isp_sec * 1000.0f),
               (unsigned)c->m1_conv, (unsigned long)c->duration_ms);
#endif
}




/************************************************************************************************************
 * CHRONOAMPEROMETRY TASK...1minute
 ************************************************************************************************************/
void max30123_M1_chrono_A_Timeout_Task(void)
{
#ifdef SWMTRACE_OUTPUT
	swmLogInfo("max30123_M1_chrono_A_Timeout_Task!!! : [%d] \r\n", max30123_chrono_A_measure_tmout);
#endif
	max30123_chrono_A_measure_tmout++;
	max30123_chrono_A_measure_tmout%=CHRONO_A_MEASURE_TIME;
	if(!max30123_chrono_A_measure_tmout) {
		max30123_measure_step = MAX30123_STEP_CHRONO_A;
		max30123_chrono_A_step= 0;

#ifdef SWMTRACE_OUTPUT
	swmLogInfo("MAX30123_STEP_CHRONO_A START \r\n");
#endif

	}
}
